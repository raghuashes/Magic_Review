# ==========================================
# Magic Review - Environment Configuration
# Copy this file to .env and fill in real values
# ==========================================

# --- Application ---
APP_NAME=Magic Review
APP_VERSION=1.0.0
# Base URL of the public frontend (used in QR codes & Google redirect)
FRONTEND_BASE_URL=https://magic-review.vercel.app
# Base URL of the backend API (used in QR codes)
BACKEND_BASE_URL=https://api.magicreview.in

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=magicreview
DB_USERNAME=magicreview
DB_PASSWORD=ChangeMe123!

# --- JWT ---
JWT_SECRET=ChangeMeSuperSecretKeyThatIsAtLeast32CharsLong!!!
JWT_ACCESS_EXPIRATION_MS=900000      # 15 min
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# --- Security ---
BCRYPT_STRENGTH=10

# --- Gemini AI (Google) ---
# Leave EMPTY to enable automatic Demo Mode fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Email (optional, for future use) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=